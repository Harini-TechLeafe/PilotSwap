# ──────────────────────────────────────────────────────────────
# PilotSwap environment variables  (copy to .env and fill in)
# All VITE_* values are bundled into the browser build and are PUBLIC.
# NEVER put private keys, seed phrases or API secrets here.
# ──────────────────────────────────────────────────────────────

# Sepolia is the startup default. The in-app network selector switches networks.
VITE_SEPOLIA_CHAIN_ID=11155111
VITE_BSC_TESTNET_CHAIN_ID=97

# Sepolia RPC and V3 contracts.
# Leave empty to use the chain's public default RPC (rate-limited).
# Recommended: a free Alchemy / Infura / QuickNode endpoint for your testnet.
# Note: an RPC URL containing an API key is visible in the browser; restrict
# the key to your domain in the provider dashboard.
VITE_SEPOLIA_RPC_URL=
VITE_SEPOLIA_SWAP_ROUTER_ADDRESS=
VITE_SEPOLIA_QUOTER_ADDRESS=
VITE_SEPOLIA_POSITION_MANAGER_ADDRESS=
VITE_SEPOLIA_FACTORY_ADDRESS=
VITE_SEPOLIA_WETH_ADDRESS=
# ERC-20 tokens you want to offer. Leave blank to hide/disable a token.
VITE_SEPOLIA_USDC_ADDRESS=
VITE_SEPOLIA_DAI_ADDRESS=
# ── BNB Smart Chain Testnet (chain ID 97) ──
# These values are used when BNB Testnet is selected in the app.
# Use PancakeSwap V3 SwapRouter (not SmartRouter): https://developer.pancakeswap.finance/contracts/v3/addresses
VITE_BSC_TESTNET_RPC_URL=
VITE_BSC_TESTNET_SWAP_ROUTER_ADDRESS=
VITE_BSC_TESTNET_QUOTER_ADDRESS=
VITE_BSC_TESTNET_POSITION_MANAGER_ADDRESS=
VITE_BSC_TESTNET_FACTORY_ADDRESS=
VITE_BSC_TESTNET_WETH_ADDRESS=
VITE_BSC_TESTNET_USDC_ADDRESS=
VITE_BSC_TESTNET_DAI_ADDRESS=
# Optional: free CoinGecko "Demo" API key (https://www.coingecko.com/en/api).
# The token price list works without it, but the keyless API is rate-limited.
VITE_COINGECKO_API_KEY=


# Ethereum MAINNET (real funds). Uniswap V3 contracts + WETH/USDC/DAI are built-in defaults; only the RPC is needed.
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# ── USDT ──
# Mainnets use the real USDT automatically. On testnets deploy contracts/MockUSDT.sol and paste the address.
VITE_SEPOLIA_USDT_ADDRESS=
VITE_BSC_TESTNET_USDT_ADDRESS=
# Optional decimals override (defaults: Sepolia 6, BNB Testnet 18, Ethereum 6, BNB Chain 18)
# VITE_SEPOLIA_USDT_DECIMALS=6
# VITE_BSC_TESTNET_USDT_DECIMALS=18

# ── BNB Smart Chain MAINNET (real funds). PancakeSwap V3 + WBNB/USDC/USDT/DAI are built-in defaults. ──
VITE_BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com
