# ──────────────────────────────────────────────────────────────
# PilotSwap environment variables  (copy to .env and fill in)
# All VITE_* values are bundled into the browser build and are PUBLIC.
# NEVER put private keys, seed phrases or API secrets here.
# ──────────────────────────────────────────────────────────────

# Chain the app runs on. Supported out of the box:
#   11155111 = Ethereum Sepolia (default)
#   84532    = Base Sepolia
#   421614   = Arbitrum Sepolia
#   11155420 = Optimism Sepolia
VITE_CHAIN_ID=11155111

# JSON-RPC URL for reads (quotes, balances, receipts).
# Leave empty to use the chain's public default RPC (rate-limited).
# Recommended: a free Alchemy / Infura / QuickNode endpoint for your testnet.
# Note: an RPC URL containing an API key is visible in the browser; restrict
# the key to your domain in the provider dashboard.
VITE_RPC_URL=

# ── REPLACE THESE with verified contract addresses on the chain above ──
# Uniswap V2-compatible Router02 (the app calls getAmountsOut + swapExact*).
VITE_SWAP_ROUTER_ADDRESS=
# The WETH9 contract that the router above uses (router.WETH()).
VITE_WETH_ADDRESS=
# ERC-20 tokens you want to offer. Leave blank to hide/disable a token.
VITE_USDC_ADDRESS=
VITE_DAI_ADDRESS=
# Test Bitcoin (tBTC): deploy contracts/MockToken.sol as ("Test Bitcoin","tBTC",8)
VITE_TBTC_ADDRESS=

# Optional: free CoinGecko "Demo" API key (https://www.coingecko.com/en/api).
# The token price list works without it, but the keyless API is rate-limited.
VITE_COINGECKO_API_KEY=

# ── Solana (send / receive only; no swap) ──
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
