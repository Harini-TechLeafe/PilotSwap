# Used ONLY by `npm run deploy` on your own computer. Never commit or share this file.
# Use a throwaway wallet that holds only Sepolia test ETH.
DEPLOYER_PRIVATE_KEY=

# Optional ─────────────────────────────────────────
# ETH put into EACH pool (ETH/USDC and ETH/DAI). Default 0.0006 → 0.0012 ETH total.
LIQ_ETH=0.0006
# Starting price of the pools: 1 ETH = this many USDC / DAI.
ETH_PRICE_USD=3000
# Extra whole tokens minted to your wallet (besides what goes into pools).
EXTRA_MINT_UNITS=100000
# Refuse to run if gas is above this many gwei (Sepolia is normally well under 1).
# MAX_GAS_GWEI=2
# Private RPC (Alchemy/Infura). Falls back to VITE_RPC_URL, then the public Sepolia RPC.
# RPC_URL=
